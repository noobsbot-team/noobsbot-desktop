+
+impl OutputDimensions {
+    /// The output's scale from its sizes, its mode's over its logical one, in the fractional-scale protocol's 1/120ths
+    /// (the logical size is rounded). Comparing the longer sides makes the transform irrelevant.
+    fn fractional_scale(&self) -> Option<f64> {
+        let (width, height) = self.logical_size?;
+        let (logical, physical) = (width.max(height), self.width.max(self.height));
+        (logical > 0 && physical > 0)
+            .then(|| (f64::from(physical) / f64::from(logical) * 120.0).round() / 120.0)
+    }
 }
 
