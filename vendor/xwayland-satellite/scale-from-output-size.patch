+/// Whether `output`'s scale comes from its sizes. A surface's preferred scale doesn't change it then: a window across
+/// two outputs is given one scale for both.
+fn scaled_by_size(world: &World, output: Entity) -> bool {
+    world
+        .get::<&OutputDimensions>(output)
+        .is_ok_and(|dimensions| dimensions.fractional_scale().is_some())
+}
+
+/// With fractional scaling, an output's scale comes from its sizes once xdg-output has given its logical one, so X11
+/// apps get its DPI before any of their windows has been on it (until then only its integer scale is known).
+fn update_scale_from_size<C: XConnection>(target: Entity, state: &mut ServerState<C>) {
+    if state.fractional_scale.is_none() {
+        return;
+    }
+    let Some(factor) = state
+        .world
+        .get::<&OutputDimensions>(target)
+        .ok()
+        .and_then(|dimensions| dimensions.fractional_scale())
+    else {
+        return;
+    };
+    if update_output_scale(
+        state.world.query_one(target).unwrap(),
+        OutputScaleFactor::Fractional(factor),
+    ) {
+        state.updated_outputs.push(target);
+    }
+}
