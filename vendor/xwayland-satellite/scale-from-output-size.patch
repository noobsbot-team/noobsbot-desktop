+#[test]
+fn fractional_output_scale_from_xdg_output_size() {
+    let mut f = TestFixture::new_pre_connect(|testwl| {
+        testwl.enable_fractional_scale();
+    });
+    let comp = f.compositor();
+    let man = f.enable_xdg_output();
+    // A 1000x1000 mode (see finalize_output) at 1.25: integer scale 2, logical size 800x800.
+    let (output_obj, output) = f.new_output(0, 0);
+    f.create_xdg_output(&man, output_obj.obj.clone());
+    output.scale(2);
+    output.done();
+    f.run();
+    f.run();
+    assert_eq!(f.satellite.inner.new_scale, Some(2.0));
+
+    // No window has been on the output yet.
+    let xdg = f.testwl.get_xdg_output(&output).expect("No xdg output");
+    xdg.logical_size(800, 800);
+    output.done();
+    f.run();
+    f.run();
+    assert_eq!(f.satellite.inner.new_scale, Some(1.25));
+
+    // A window given another output's scale (it is mostly there) doesn't change this one's.
+    let (_, id) = f.create_toplevel(&comp, Window::new(1));
+    let fractional = f
+        .testwl
+        .get_surface_data(id)
+        .expect("No surface data")
+        .fractional
+        .as_ref()
+        .expect("No fractional scale for surface");
+    fractional.preferred_scale(240);
+    f.testwl.move_surface_to_output(id, &output);
+    f.run();
+    f.run();
+    assert_eq!(f.satellite.inner.new_scale, Some(1.25));
+}
