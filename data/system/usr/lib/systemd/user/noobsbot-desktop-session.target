# Started by noobsbot-desktop-session once the compositor listens (plan.md E6.7):
# brings up graphical-session.target, the keyring, the user folders (xdg-user-dirs; its autostart
# entry is skipped under systemd) and the XDG autostart apps. The portals start on demand over D-Bus.
# The polkit agent is the compositor's own (E7.2); it starts plasma-polkit-agent.service (polkit-kde-agent, kept
# installed as the fallback) only when its own registration fails.
[Unit]
Description=Noobsbot Desktop session
BindsTo=graphical-session.target
Wants=graphical-session-pre.target xdg-desktop-autostart.target gnome-keyring-daemon.socket
Wants=xdg-user-dirs.service
After=graphical-session-pre.target
Before=graphical-session.target xdg-desktop-autostart.target
